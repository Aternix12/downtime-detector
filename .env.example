PORT=3000
# Optional override. If unset, built-in site profiles are used
# (Betashares AU + Direct + NZ + Aternix), including functional path checks.
TARGETS=https://www.betashares.com.au,https://www.betashares.com.au/direct,https://www.betashares.co.nz,https://www.aternix.com
CHECK_INTERVAL_CRON=*/2 * * * *
REQUEST_TIMEOUT_MS=20000
FUNCTIONAL_TIMEOUT_MS=15000
FUNCTIONAL_DELAY_MS=500
REQUEST_RETRIES=3
ASSET_CONCURRENCY=8
# Fail if more than this % of root assets error (0 = any asset failure fails the site)
MAX_ASSET_FAILURE_RATIO=0
# Keep false for low-cost functional checks (HTTP/title/body only)
FUNCTIONAL_CHECK_ASSETS=false
# Cooldown between phone alerts per target (minutes)
ALERT_COOLDOWN_MINUTES=30
# Require N consecutive failures before calling
FAILURE_THRESHOLD=2
ALERT_PHONE=+61476977380
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+61343279233
# Optional Discord webhook for text alerts too
DISCORD_WEBHOOK_URL=
# Public dashboard basic auth (optional). Leave blank for open status page.
DASHBOARD_USER=
DASHBOARD_PASS=
